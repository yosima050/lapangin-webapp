# =============================================================================
# LapangIn — .env Staging Template
# Salin file ini ke .env dan isi nilai yang bertanda <GANTI_INI>
# =============================================================================

APP_NAME="LapangIn (Staging / Testing)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://lapangin.australiaeast.cloudapp.azure.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

# ── Database PostgreSQL Staging ───────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=lapangin_staging_db                    # hostname container database staging
DB_PORT=5432
DB_DATABASE=lapangin_db_staging
DB_USERNAME=lapangin_user
DB_PASSWORD=lapangin_staging_secret

# ── Session & Cache ───────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_COOKIE=lapangin_staging_session
CACHE_STORE=database

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ── Mail (SMTP production) ────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=<GANTI_INI>                       # misal: smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<GANTI_INI>
MAIL_PASSWORD=<GANTI_INI>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@lapangin.example.com
MAIL_FROM_NAME="LapangIn"

# ── Midtrans Payment Gateway (Sandbox untuk Staging) ─────────────────────────
MIDTRANS_SERVER_KEY=<GANTI_INI>
MIDTRANS_CLIENT_KEY=<GANTI_INI>
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# ── Google OAuth (opsional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<GANTI_INI>
GOOGLE_CLIENT_SECRET=<GANTI_INI>
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=warning

